  { "id": "ponte-papel", "emoji": "🌉", "text": "用纸或纸板在两把椅子之间搭一座桥。", "category": "工程", "supervision": "自己" },
  { "id": "flutua-afunda", "emoji": "🛁", "text": "在浴缸里,找出3样会浮起来和3样会沉下去的东西。", "category": "科学", "supervision": "大人" },
